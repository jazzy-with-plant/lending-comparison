{
  "name": "lending-market-structure-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9.0" },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "lint": "eslint src scripts/collect-hyperliquid.ts vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "collect:hyperliquid": "tsx scripts/collect-hyperliquid.ts",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sql.js": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "6.1.0",
    "vitest": "^3.2.4"
  }
}
